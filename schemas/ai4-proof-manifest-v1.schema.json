{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.thesingulant.ai/schemas/ai4-proof-manifest-v1.schema.json",
  "title": "AI4ProofManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "issued_at", "issuer", "artifact"],
  "properties": {
    "schema_version": { "const": "ai4.proof-manifest.v1" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.ai4$"
        }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "uns-name" },
        "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.ai4$" },
        "owner": {
          "type": ["string", "null"],
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_type": { "type": ["string", "null"] }
      }
    },
    "proof": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
